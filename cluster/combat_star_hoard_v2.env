# Star-hoarding penalty on the v2 combat setup (CHANGELOG 071).
#
# The privileged-critic reference (combat_v2b_pcritic_2m) researches about one tech per game and ends turns 13-17
# holding 35-45 stars. The v2 reward charges research (TECH_COST 0.05/star, UNUSED_TECH 0.5 per tech not used the
# same turn) and nothing charges unspent stars, so banking them is free. STAR_HOARD charges 0.02 per star above 10
# still held at each END_TURN: holding 30 stars costs 0.4 per turn, about the one-off penalty on a used 8-star tech.
#
# Usage (repo root), from scratch with the privileged critic, as the reference:
#   source cluster/combat_star_hoard_v2.env && EXP_NAME=combat_v2b_pcritic_hoard_2m_seed1 SEED=1 \
#   TOTAL_TIMESTEPS=2000000 EXTRA_PPO_ARGS="${EXTRA_PPO_ARGS:-} --privileged-critic" \
#   sbatch --cpus-per-task=32 --mem=48G --time=36:00:00 cluster/train_combat_cpu.sbatch

_sh_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _sh_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_sh_dir/combat_cap_all_v2.env"

export POLYVISION_COMBAT_REWARD_STAR_HOARD="${POLYVISION_COMBAT_REWARD_STAR_HOARD:-0.02}"
export POLYVISION_COMBAT_REWARD_STAR_HOARD_THRESHOLD="${POLYVISION_COMBAT_REWARD_STAR_HOARD_THRESHOLD:-10}"
