# Self-play league on the v2 combat setup (pol_env/Tribes/py/combat_selfplay.py, CHANGELOG 064).
#
# Half the games are against SimpleAgent, half against frozen snapshots chosen by prioritised fictitious self-play
# (opponents the learner beats less often are picked more): the learner's own checkpoints, saved every 100k steps,
# plus any fixed opponents in LEAGUE_GLOB (e.g. the finished v2b runs). Start from a trained checkpoint: a fresh
# network's snapshots are too weak to teach anything.
#
# Usage (repo root, after the v2b runs have finished):
#   INIT_FROM=runs/<v2b run>/combat_cap_all_v2b_2m_seed1.cleanrl_model \
#   LEAGUE_GLOB="runs/Tribes-v0__combat_cap_all_v2b_*/combat_cap_all_v2b_*.cleanrl_model" \
#   source cluster/combat_selfplay_v2.env && EXP_NAME=combat_selfplay_v2_2m TOTAL_TIMESTEPS=2000000 \
#   sbatch --cpus-per-task=32 --mem=48G --time=36:00:00 cluster/train_combat_cpu.sbatch
# Snapshot games run the opponent network inside each env worker (CPU), so steps are slower than against
# SimpleAgent; hence the longer time limit. The win rate logged by training mixes both opponents; W&B also shows
# end_raw/win_vs_simple, end_raw/win_vs_snapshot and end_raw/opponent_snapshot (the share of snapshot games).
# Judge the result with the canonical evaluation against SimpleAgent (tools/evaluate_combat.py).

_sp_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _sp_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_sp_dir/combat_cap_all_v2.env"

export POLYVISION_COMBAT_LEAGUE=1
export POLYVISION_COMBAT_LEAGUE_SELF=1                         # ppo.py points the workers at this run's checkpoints
export POLYVISION_COMBAT_LEAGUE_GLOB="${LEAGUE_GLOB:-}"
export POLYVISION_COMBAT_LEAGUE_SIMPLE_PROB="${LEAGUE_SIMPLE_PROB:-0.5}"
export POLYVISION_COMBAT_LEAGUE_MAX_SNAPSHOTS="${LEAGUE_MAX_SNAPSHOTS:-8}"
export EXTRA_PPO_ARGS="${EXTRA_PPO_ARGS:-} --save-frequency ${LEAGUE_SNAPSHOT_EVERY:-100000}"
