# Combat fog memory on the v2 combat setup (core.game.FogMemory, CHANGELOG 066).
#
# The policy also sees what it remembers and infers about enemy units it cannot see (4 extra spatial channels and 3
# scalars), and the tactical search places remembered units it is sure about. Fog here is unexplored tiles: units
# on explored tiles are always visible, so this helps with units in the clouds (mostly the first 15 turns).
# POLYVISION_FOG_MEMORY_SEE_MOVES=0 stops following watched moves into the fog (see docs/combat-next-steps.md).
#
# Usage (repo root, after the v2b runs have finished). From scratch:
#   source cluster/combat_fog_memory_v2.env && EXP_NAME=combat_fog_memory_v2_2m TOTAL_TIMESTEPS=2000000 \
#   sbatch --cpus-per-task=32 --mem=48G --time=24:00:00 cluster/train_combat_cpu.sbatch
# Or warm-started from a v2b checkpoint (combat_cap_all_v2.env passes INIT_FROM to --init-from, which gives the new inputs zero weight, so it starts as that policy):
#   INIT_FROM=runs/<v2b run>/combat_cap_all_v2b_2m_seed1.cleanrl_model source cluster/combat_fog_memory_v2.env ...
# Checkpoints carry "+fog_memory_v1" in their environment version; the evaluator turns fog memory on for them.

_fm_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _fm_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_fm_dir/combat_cap_all_v2.env"

export POLYVISION_FOG_MEMORY=1
export POLYVISION_FOG_MEMORY_SEE_MOVES="${POLYVISION_FOG_MEMORY_SEE_MOVES:-1}"
