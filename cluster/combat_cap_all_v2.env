# combat_cap_all v2: Kevin's combat_cap_all_2m reward (cluster/combat_cap_all.env) moved to the Polytopia 2.15
# rules (revision 2: Step 2 economy, Diplomacy, embassy cost) and the composed network, with three reward
# changes asked for on 2026-11-14:
#   1. prefer Riders over Warriors and Swordsmen;
#   2. never reward embassies (in a 1v1 an embassy pays the enemy as much as us);
#   3. push for wins before the 20-turn limit (cap_all timed out in 48.9% of games).
#
# Usage (from a Farmshare checkout of exp/combat-capall-v2):
#   source cluster/combat_cap_all_v2.env && EXP_NAME=combat_cap_all_v2_2m sbatch cluster/train_combat_cpu.sbatch
# To warm-start from Kevin's cap_all checkpoint (spatial_resnet_local, 2020 rules), set INIT_FROM to its
# .cleanrl_model path before sourcing; the sidecar .action_interface.json must sit next to it. ppo.py --init-from
# remaps the input layers for the 2.15 observation (new inputs start at zero weight), seeds the composed action
# types from its per-id embeddings and re-initialises the critic (the reward changed). Kevin's runs did not
# upload checkpoints to W&B; upload one with: python tools/wandb_checkpoint.py upload PATH --name combat_cap_all_2m
#
# The new weights are starting values, not tuned. Results under these rules are not comparable with the
# tribes_2020 combat runs in docs/experiments.md.

# The base weights live next to this file (BASH_SOURCE in bash; other shells: run from the repository root).
_cap_all_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _cap_all_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_cap_all_dir/combat_cap_all.env"

# Rules and network.
export POLYVISION_RULES=polytopia_2_15
export NETWORK_ARCH=spatial_resnet_composed
export NUM_ENVS=${NUM_ENVS:-16}                          # as in Kevin's cap_all runs
export POLYVISION_LEVEL_SELECTION_MODE=${POLYVISION_LEVEL_SELECTION_MODE:-seeded_random}
if [ -n "${INIT_FROM:-}" ]; then
    export EXTRA_PPO_ARGS="${EXTRA_PPO_ARGS:-} --init-from ${INIT_FROM}"
fi

# 1. Riders over Warriors and Swordsmen. The unit potential already pays 0.1 per unit plus 0.05 per star of unit
#    cost, which favours the 5-star Swordsman (+0.35) over the 3-star Rider (+0.25) and the Warrior (+0.2). A
#    potential of 0.3 per Rider alive lifts the Rider to +0.55. Being a potential, a Rider that dies takes its
#    reward back, so training Riders to lose them cannot be farmed, and a full 16-unit Rider army is worth
#    about +5 (half paid at game end), well below a win (30). Small bonus per Rider attack.
#    (Not used: TRAIN_RIDER/TRAIN_INFANTRY, one-off rewards for training. Per game they could swing ~24, close to
#    the win reward, and a Rider that dies still kept its training reward.)
export POLYVISION_COMBAT_REWARD_RIDER=0.3
export POLYVISION_COMBAT_REWARD_RIDER_ATTACK=0.1

# 2. Embassies. No existing term rewards them directly; this penalty makes the agent avoid them outright.
export POLYVISION_COMBAT_REWARD_EMBASSY=5

# 3. Win before turn 20, and make the outcome outweigh "who is ahead".
#    In cap_all the potential terms paid about 20 per game against 14.7 for the outcome (W&B vis7ipn7), so timing
#    out with a lead was worth about two thirds of a win. Here every outcome term is doubled and the lead is paid
#    only half at game end:
#    - win 60 (was 30), timeout -10 (was 0): win minus timeout is 70, more than three times the whole lead a game
#      typically builds (~20, of which ~10 is paid at a timeout);
#    - loss -15 (was -10): only 5 below a timeout, so playing safe to avoid a loss buys little. An all-in attack
#      that would otherwise time out pays off if it wins at least 1 time in 15 (70p > 5(1-p)); in cap_all it
#      needed 1 in 4 (30p > 10(1-p)), and the timeout also kept the whole lead. Losses were rare (2.1%) anyway;
#    - early-win bonus 60 x (1 - turns/20) (was 20): a turn-10 win earns 60 + 30;
#    - each turn costs 0.25 (5 over a full game).
#    The shaping and event weights are unchanged, so relative to the outcome they are halved.
export POLYVISION_COMBAT_REWARD_WIN=60
export POLYVISION_COMBAT_REWARD_LOSS=-15
export POLYVISION_COMBAT_REWARD_TIMEOUT=-10
export POLYVISION_COMBAT_REWARD_TERMINAL_POTENTIAL=0.5
export POLYVISION_COMBAT_REWARD_TURN_PENALTY=0.25
export POLYVISION_COMBAT_REWARD_EARLY_WIN=60
