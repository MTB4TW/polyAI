# Outcome-only fine-tuning of a combat checkpoint (docs/rewards.md, CHANGELOG 063).
#
# Starts from a trained combat checkpoint and trains on the game result: win 60, loss -15, timeout -10, the
# early-win bonus and the per-turn cost (the v2 outcome terms). Every shaping term ("who is ahead" potential and
# per-step events, including the Rider and embassy terms) is multiplied by SHAPING_SCALE: 0 = outcome only.
# The critic is re-initialised (its values were in shaped-reward units) and the learning rate is lowered.
#
# Prefer cluster/run_combat_finetune.sh, which fades the shaping out in two dependent jobs (0.5, then 0).
# By hand:
#   INIT_FROM=runs/X/X.cleanrl_model SHAPING_SCALE=0 source cluster/combat_outcome_finetune.env \
#     && EXP_NAME=NAME TOTAL_TIMESTEPS=1000000 sbatch --cpus-per-task=32 --mem=48G --time=24:00:00 \
#        cluster/train_combat_cpu.sbatch
# The checkpoint must use the same rules, network and catalog as this run (the v2 setup: 2.15 rules, composed).

_ft_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _ft_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_ft_dir/combat_cap_all_v2.env"

if [ -z "${INIT_FROM:-}" ]; then
    echo "combat_outcome_finetune.env: set INIT_FROM to the checkpoint to fine-tune" >&2
    return 1 2>/dev/null || exit 1
fi
export POLYVISION_COMBAT_REWARD_SHAPING_SCALE="${SHAPING_SCALE:-0}"
# combat_cap_all_v2.env already appended --init-from; add the critic reset (RESET_CRITIC=0 keeps it, e.g. for a
# second fade stage whose reward is close to the first) and a lower learning rate.
_ft_reset="critic."
if [ "${RESET_CRITIC:-1}" = "0" ]; then _ft_reset="none"; fi
export EXTRA_PPO_ARGS="${EXTRA_PPO_ARGS:-} --init-from-reset ${_ft_reset} --learning-rate ${FINETUNE_LR:-2e-4}"
