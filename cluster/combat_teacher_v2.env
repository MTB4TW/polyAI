# Kickstart combat PPO from the tactical search teacher (players/heuristics/CombatTactics.java, CHANGELOG 065).
#
# Adds coef * cross-entropy(policy, teacher's action) on the decisions where the within-turn tactical search
# (attack order, kills, captures, blocking) finds a sequence that beats stopping now; elsewhere there is no label.
# The coefficient decays linearly to 0 over the first TEACHER_DECAY_FRAC of training, then the search is switched
# off in the workers. The search runs in every env worker while it is on, so early training is slower.
#
# Usage (repo root), from scratch or warm-started with INIT_FROM:
#   source cluster/combat_teacher_v2.env && EXP_NAME=combat_teacher_v2_2m TOTAL_TIMESTEPS=2000000 \
#     sbatch --cpus-per-task=32 --mem=48G --time=24:00:00 cluster/train_combat_cpu.sbatch

_tt_dir="cluster"
if [ -n "${BASH_SOURCE:-}" ]; then _tt_dir="$(dirname "${BASH_SOURCE[0]}")"; fi
source "$_tt_dir/combat_cap_all_v2.env"
export EXTRA_PPO_ARGS="${EXTRA_PPO_ARGS:-} --teacher tactical_search --teacher-coef ${TEACHER_COEF:-1.0} --teacher-decay-frac ${TEACHER_DECAY_FRAC:-0.3}"
