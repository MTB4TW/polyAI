# Combat reward weights for Kevin's `combat_cap_all_2m` configuration (best combat result so far:
# 47.1% win vs SimpleAgent at 2M steps, docs/experiments.md). Copied from the W&B run config of
# vis7ipn7 (Tribes-v0__combat_cap_all_2m_seed1). Weights left at 0 there are left unset here.
#
# Usage: source cluster/combat_cap_all.env before sbatch, e.g.
#   source cluster/combat_cap_all.env && EXP_NAME=... sbatch cluster/train_combat_cpu.sbatch
export POLYVISION_COMBAT_REWARD_WIN=30
export POLYVISION_COMBAT_REWARD_LOSS=-10
export POLYVISION_COMBAT_REWARD_EARLY_WIN=20
export POLYVISION_COMBAT_REWARD_CITY=1
export POLYVISION_COMBAT_REWARD_SCORE_PER_1000=1
export POLYVISION_COMBAT_REWARD_KILL=0.25
export POLYVISION_COMBAT_REWARD_GIANT=0.5
export POLYVISION_COMBAT_REWARD_UNIT=0.1
export POLYVISION_COMBAT_REWARD_UNIT_VALUE=0.05
export POLYVISION_COMBAT_REWARD_TILE=0.05
export POLYVISION_COMBAT_REWARD_ROAD=0.05
export POLYVISION_COMBAT_REWARD_TERMINAL_POTENTIAL=1
export POLYVISION_COMBAT_REWARD_CAPITAL_HOLD=1
export POLYVISION_COMBAT_REWARD_CAPITAL_PROXIMITY=0.3
export POLYVISION_COMBAT_REWARD_CAPITAL_PROXIMITY_LATE=0.6
export POLYVISION_COMBAT_REWARD_CAPITAL_REGION_KILL=0.5
export POLYVISION_COMBAT_REWARD_REGIONAL_ATTACK=0.3
export POLYVISION_COMBAT_REWARD_DAMAGE_TRADE=0.02
export POLYVISION_COMBAT_REWARD_ZONE_OF_CONTROL=0.05
export POLYVISION_COMBAT_REWARD_ROLE_POSITIONING=0.05
export POLYVISION_COMBAT_REWARD_HANGING_POPULATION=0.1
export POLYVISION_COMBAT_REWARD_POP_TECH=0.2
export POLYVISION_COMBAT_REWARD_TECH_ORDER=0.1
export POLYVISION_COMBAT_REWARD_TECH_COST=0.05
export POLYVISION_COMBAT_REWARD_UNUSED_TECH=0.5
export POLYVISION_COMBAT_REWARD_AVOID_FISHING=5
export POLYVISION_COMBAT_REWARD_AVOID_PHILOSOPHY_MEDITATION=2
export POLYVISION_COMBAT_REWARD_AVOID_WHALING=2
